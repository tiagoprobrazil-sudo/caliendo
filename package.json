{
  "name": "caliendo-psi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "assets": "node scripts/prepare-assets.mjs",
    "build": "npm run assets && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "validate": "npm run check && npm run lint && npm run build",
    "test:smoke": "node scripts/smoke.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.2",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "1.7.0",
    "ffmpeg-static": "5.3.0",
    "globals": "17.12.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "wrangler": "4.133.0"
  }
}
