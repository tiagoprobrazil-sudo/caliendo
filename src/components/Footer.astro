---
import { navigation, site } from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="Eduardo Caliendo — página inicial">
        <img class="brand-mark" src="/images/emblem-dark-320.webp" alt="" width="72" height="72" decoding="async" />
        <span class="brand-text">
          <span class="brand-name">Eduardo Caliendo</span>
          <span class="brand-caption">PSICANÁLISE & FILOSOFIA</span>
        </span>
      </a>
      <p>Um espaço para se escutar.<br />Um tempo para se conhecer.</p>
    </div>
    <nav class="footer-nav" aria-label="Navegação do rodapé">
      <span class="footer-heading">Navegação</span>
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="footer-contact">
      <span class="footer-heading">Contato</span>
      <a href={site.phoneHref}>{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a class="text-link" href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span><span class="sr-only"> (abre em nova aba)</span></a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {site.person}. Todos os direitos reservados.</span>
    <a href="/privacidade/">Privacidade</a>
    <span>Rio de Janeiro, Brasil</span>
    <span>Desenvolvido por <a href="https://www.tiagobrazil.com.br/" target="_blank" rel="noopener noreferrer">Tiago Brazil<span aria-hidden="true"> ↗</span><span class="sr-only"> (abre em nova aba)</span></a></span>
  </div>
</footer>
