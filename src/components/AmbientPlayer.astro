<div class="ambient-player">
  <audio class="ambient-audio" preload="none"></audio>
  <button type="button" class="ambient-toggle" aria-pressed="false">
    <span class="sr-only">Tocar música de fundo</span>
    <svg class="icon icon-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4 9.91 6.09 12 8.18V4z" /></svg>
    <svg class="icon icon-on icon--hidden" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" /></svg>
  </button>
</div>
<script>
  const player = document.querySelector<HTMLDivElement>('.ambient-player');
  const audio = player?.querySelector<HTMLAudioElement>('.ambient-audio');
  const toggle = player?.querySelector<HTMLButtonElement>('.ambient-toggle');
  const iconOff = player?.querySelector<SVGElement>('.icon-off');
  const iconOn = player?.querySelector<SVGElement>('.icon-on');
  const srLabel = player?.querySelector<HTMLElement>('.sr-only');

  if (audio && toggle && iconOff && iconOn && srLabel) {
    const tracks = [
      { src: '/audio/eco-do-tempo.mp3', title: 'Eco do Tempo' },
      { src: '/audio/espelho-interior.mp3', title: 'Espelho Interior' },
      { src: '/audio/instante-de-escuta.mp3', title: 'Instante de Escuta' },
      { src: '/audio/silencio-necessario.mp3', title: 'Silêncio Necessário' },
    ];

    // Embaralha a ordem uma vez por carregamento, então o início é sempre
    // uma faixa aleatória; o avanço depois segue essa ordem embaralhada
    // e volta ao início ao terminar, num loop contínuo pela playlist.
    const order = [...tracks];
    for (let i = order.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const temp = order[i]!;
      order[i] = order[j]!;
      order[j] = temp;
    }
    let index = 0;

    const playCurrent = () => {
      const current = order[index]!;
      audio.src = current.src;
      toggle.title = current.title;
      audio.play().catch(() => {});
    };

    audio.addEventListener('ended', () => {
      index = (index + 1) % order.length;
      playCurrent();
    });

    audio.addEventListener('play', () => {
      toggle.setAttribute('aria-pressed', 'true');
      iconOff.classList.add('icon--hidden');
      iconOn.classList.remove('icon--hidden');
      srLabel.textContent = `Pausar música de fundo — ${order[index]!.title}`;
    });

    audio.addEventListener('pause', () => {
      toggle.setAttribute('aria-pressed', 'false');
      iconOff.classList.remove('icon--hidden');
      iconOn.classList.add('icon--hidden');
      srLabel.textContent = 'Tocar música de fundo';
    });

    toggle.addEventListener('click', () => {
      if (audio.paused) {
        if (!audio.src) playCurrent();
        else audio.play().catch(() => {});
      } else {
        audio.pause();
      }
    });
  }
</script>
