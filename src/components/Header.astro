---
import { navigation, site } from '../data/site';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="CALIENDO PSI — página inicial">
      <span class="brand-name">CALIENDO <span>PSI</span></span>
      <span class="brand-caption">PSICANÁLISE & FILOSOFIA</span>
    </a>
    <nav class="desktop-nav" aria-label="Navegação principal">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header-contact" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Vamos conversar <span aria-hidden="true">↗</span><span class="sr-only"> pelo WhatsApp (abre em nova aba)</span></a>
    <details class="mobile-menu">
      <summary aria-label="Abrir ou fechar navegação"><span>Menu</span><span class="menu-lines" aria-hidden="true"></span></summary>
      <nav aria-label="Navegação móvel">{navigation.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if (menu) {
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  }
</script>
